# Copy to .env and edit. docker compose reads it automatically.
# Nothing here is committed: .env is gitignored. See docs/SETUP.md.

# --- image ----------------------------------------------------------------
DC_IMAGE=ghcr.io/awdimartino/navidrome-companion:latest

# --- paths on the host ----------------------------------------------------
# The library, mounted at /music. Navidrome must see it at /music too - see
# docs/SETUP.md, "Paths must match Navidrome's".
LIBRARY_DIR=/srv/music

# Scratch space for downloads and the drop-in inboxes, mounted at /downloads.
# Empty at rest. Keep it on the same disk as the library if you can, so a
# finished file is filed with a rename rather than a copy.
STAGING_DIR=/srv/staging

# config.toml, state.db and each person's beets config. Keep it on real
# disk, not a tmpfs, and back it up: state.db holds your listening history.
CONFIG_DIR=/srv/navidrome-companion/config

# Navidrome's data directory (the one holding navidrome.db), mounted
# read-only at /navidrome.
NAVIDROME_DATA_DIR=/srv/navidrome/data

# --- ownership ------------------------------------------------------------
# Must match whoever owns LIBRARY_DIR. Find it with:  stat -c '%u %g' /srv/music
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- network --------------------------------------------------------------
PORT=8000

# --- Navidrome ------------------------------------------------------------
# Where Navidrome answers, as seen from inside this container. Required:
# signing in here means signing in to Navidrome. On one compose network with
# a service called navidrome, that is http://navidrome:4533.
DC_NAVIDROME_URL=

# --- credentials ----------------------------------------------------------
# Optional. These override config.toml and the Settings panel when set.
DC_SPOTIFY_CLIENT_ID=
DC_SPOTIFY_CLIENT_SECRET=
