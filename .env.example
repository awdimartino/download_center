# Copy to .env and edit. docker compose reads it automatically.
# Nothing here is committed: .env is gitignored.

# --- image ----------------------------------------------------------------
# The published image to run. Published image for this repo.
DC_IMAGE=ghcr.io/awdimartino/download_center:latest

# --- paths on the host ----------------------------------------------------
# Staging area. Downloads land here and beets moves them out, so it stays
# empty apart from anything beets could not confidently match.
STAGING_DIR=/mnt/music/untagged

# The tagged library. beets files into this using the paths in
# config/beets/config.yaml. This is what your music server should index.
LIBRARY_DIR=/mnt/music/library

# Where config.toml and the download ledger live. Keep it on real disk, not
# a tmpfs: losing state.db means re-downloading everything.
CONFIG_DIR=/home/pi/download-center/config

# --- ownership ------------------------------------------------------------
# Must match whoever owns MUSIC_DIR. Find it with:  stat -c '%u %g' /mnt/music
PUID=1000
PGID=1000
TZ=Europe/Dublin

# --- network --------------------------------------------------------------
PORT=8000

# --- credentials ----------------------------------------------------------
# Optional. These override config.toml when set.
DC_SPOTIFY_CLIENT_ID=
DC_SPOTIFY_CLIENT_SECRET=
